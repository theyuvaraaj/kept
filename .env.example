# Copy to .env and fill from Supabase → Project Settings → API.
# EXPO_PUBLIC_* is bundled into the app; the anon key is public-safe (RLS guards data).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Map search provider. Priority: Mappls → Google → free OSM fallback.
# Mappls (MapmyIndia) — free tier, great India coverage. From apis.mappls.com.
EXPO_PUBLIC_MAPPLS_CLIENT_ID=YOUR-MAPPLS-CLIENT-ID
EXPO_PUBLIC_MAPPLS_CLIENT_SECRET=YOUR-MAPPLS-CLIENT-SECRET
# Google Places (New) — optional alternative. Restrict to Android + Places API.
EXPO_PUBLIC_GOOGLE_PLACES_KEY=YOUR-GOOGLE-PLACES-KEY
