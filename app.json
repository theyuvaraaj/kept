{
  "expo": {
    "name": "Kept",
    "slug": "kept",
    "scheme": "kept",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f4f1e7"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#8fae5e"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kept uses your location to confirm you're at your spot when you check in.",
          "locationAlwaysAndWhenInUsePermission": "Kept uses your location to auto-check-in when you arrive at your spot during the window.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.theyuvaraaj.kept",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "com.theyuvaraaj.kept",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8fae5e"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "75fc8150-ca1c-48fb-bdf9-796fca5e9087"
      }
    },
    "owner": "theyuvaraaaaj"
  }
}
